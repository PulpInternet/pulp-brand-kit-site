{
  "kit": "Pulp Brand Kit 2026",
  "version": "v6d-LibreFranklin",
  "shell": {
    "bar": {
      "mark": "pulp-wordmark",
      "nav": [
        "Research",
        "Laboratory",
        "Platform",
        "Foundation",
        "What we do",
        "Company"
      ],
      "right": [
        "mode-switch",
        "search-trigger",
        "contact-trigger"
      ],
      "phone": [
        "contact-trigger",
        "menu-button"
      ],
      "sticky": true,
      "z": "--z-bar",
      "states": [
        "top",
        "peek",
        "folded"
      ],
      "fold": {
        "button": "pulp-wordmark",
        "size": 96,
        "place": "bottom-end",
        "menu": [
          "nav",
          "mode-switch",
          "contact-trigger"
        ],
        "aside_when_mark_crosses": [
          "footer wordmark",
          "robot",
          "[data-keep-clear]"
        ]
      }
    },
    "footer": {
      "groups": [
        "Research",
        "Laboratory",
        "Platform",
        "Foundation",
        "What we do",
        "Company",
        "Trust"
      ],
      "closing": [
        "pulp-wordmark",
        "EST. 2026",
        "Brooklyn, New York"
      ],
      "mode_switch": false,
      "credits": "None: each photo credits its photographer in its caption"
    },
    "always": [
      "skip-link",
      "contact-modal",
      "search",
      "sheet"
    ],
    "files": {
      "css": [
        "tokens.css",
        "site.css"
      ],
      "js": "site.js",
      "images": "img/",
      "marks": "marks/",
      "plates": "plates/"
    },
    "budget": {
      "firstViewKBgz": 200,
      "note": "Per page, photos excluded. The single-file landing page is 198 KB gzip with every plate inlined; the multi-page site serves plates, marks and fonts as cached files instead of data URIs."
    },
    "noJs": "Every page reads and navigates without JavaScript: the mode follows the system setting, the contact modal falls back to /company/contact, search falls back to the footer map, records render inline as details elements, and every form posts as a plain HTML form.",
    "search": {
      "index": "search.json",
      "written_by": "site_pages.py",
      "fields": [
        "title",
        "path",
        "group",
        "summary"
      ],
      "groups": [
        "Pages",
        "Papers",
        "Stories",
        "Docs"
      ]
    },
    "conversations": "Every action that starts a conversation (Get in touch, Invite us, Apply, Partner with the Foundation, Contact press, Talk to us, Report a barrier, Report a vulnerability) opens the contact modal with its topic preset; there is one inbox.",
    "storage": "The saved mode is the only thing the site stores, in localStorage, wrapped in try/catch. No cookies, no third-party scripts, no analytics beacons."
  },
  "sectionKinds": {
    "hero": {
      "built": "p-hero",
      "parts": "eyebrow label, display headline with the one Highlighter block, lede, one primary and one secondary button, the gum robot cropped off the edge",
      "photo": "optional hero photo (slot) under --grad-hero"
    },
    "page-head": {
      "built": "spec",
      "parts": "breadcrumb, h1 at --t-display, a lede of at most two lines at --t-title, the page's plate or mark at most 320 px wide on the right from 1024",
      "photo": null
    },
    "lede": {
      "built": "p-lede",
      "parts": "one paragraph at --t-title in the column",
      "photo": null
    },
    "band": {
      "built": "p-section p-band",
      "parts": "a section on --c-band with a heading and a short essay",
      "photo": null
    },
    "plates": {
      "built": "p-plate",
      "parts": "one to three plates, each a button that previews and pins its plain label",
      "photo": null
    },
    "ledger": {
      "built": "p-ledger",
      "parts": "term on the left, one sentence on the right, ruled rows",
      "photo": null
    },
    "cards": {
      "built": "p-grid p-card",
      "parts": "ruled cards (a rule, never a filled box), mark or icon, title, one line, a link",
      "photo": null
    },
    "list": {
      "built": "spec",
      "parts": "ruled rows: title, status label, venue or date, one line; each row is a details element with the record inline, upgraded by script to open the details modal and set the hash",
      "photo": null
    },
    "filter": {
      "built": "spec",
      "parts": "chips that wrap and never scroll sideways; Clear all; the count of results in a live region",
      "photo": null
    },
    "prose": {
      "built": "spec",
      "parts": "the 680 px column: h2, h3, paragraphs, lists, quotes as plain indented text, footnote-style sources",
      "photo": null
    },
    "toc": {
      "built": "spec",
      "parts": "contents of a long read: a sticky rail 240 px wide from 1280, a disclosure at the top below 1280; the current part marked with aria-current",
      "photo": null
    },
    "figure": {
      "built": "spec",
      "parts": "a figure on the text's left edge with a caption that holds unit, n or source",
      "photo": null
    },
    "chart": {
      "built": "spec",
      "parts": "a chart from pack data slots with Provenance, values as text, a table fallback",
      "photo": null
    },
    "code": {
      "built": "spec",
      "parts": "code as selectable text in --f-reading with tabular numbers, a copy button, never a picture of code",
      "photo": null
    },
    "modules": {
      "built": "p-sdks p-mods",
      "parts": "an SDK's mark, its line, and its modules with their icons",
      "photo": null
    },
    "people": {
      "built": "spec",
      "parts": "a grid of people: photo (consent on file, never dithered), name, role, their color as a 12 px chip; a bio opens in a floating modal",
      "photo": "person photos (slot)"
    },
    "photo": {
      "built": "p-photo",
      "parts": "a full-bleed band with parallax and a one-line caption on the scrim",
      "photo": "band photo (slot)"
    },
    "photo-break": {
      "built": "spec",
      "parts": "a band three quarters as tall as a photo band, inside a section between two of its parts, same parallax and credit",
      "photo": "break photo (slot)"
    },
    "scale": {
      "built": "p-scale",
      "parts": "the dot scale from one person to a mesh",
      "photo": null
    },
    "research": {
      "built": "p-section",
      "parts": "the section with id research: talks and acceptances with exact status",
      "photo": null
    },
    "form": {
      "built": "p-field",
      "parts": "labeled fields, validation on blur and on send, the status line in a live region",
      "photo": null
    },
    "related": {
      "built": "spec",
      "parts": "three ruled cards to the next pages a reader needs",
      "photo": null
    },
    "cta": {
      "built": "p-cta",
      "parts": "the one feature block: heading, one line, the inverted primary button or the short form (subscribe, join the list, request access), the robot's peek on Pulp pages that allow it",
      "photo": "optional feature photo"
    },
    "robot": {
      "built": "p-robot",
      "parts": "the gum robot at its About placement, engraved with the line dither, the one place that texture is used",
      "photo": null
    },
    "not-found": {
      "built": "spec",
      "parts": "the gum robot at rest, one line, search and Home",
      "photo": null
    },
    "doors": {
      "built": "preview",
      "parts": "Pulp101's two doors, Letters and Numbers: each a ruled card with its name, one line, and Sign in, which opens the sign-in modal",
      "photo": null
    },
    "steps": {
      "built": "preview",
      "parts": "three numbered steps under a 2 px rule: number, title, one line",
      "photo": null
    },
    "cues": {
      "built": "preview",
      "parts": "anchors and cues: five anchor glyphs in --c-api and six cue glyphs in --c-dye, each with a name and one line",
      "photo": null
    }
  },
  "templates": [
    {
      "id": "essay",
      "use": "The home page: a short essay in sections",
      "sections": [
        "hero",
        "band",
        "plates",
        "photo",
        "ledger",
        "cards",
        "modules",
        "photo-break",
        "research",
        "photo",
        "scale",
        "cta"
      ]
    },
    {
      "id": "hub",
      "use": "A section's front page",
      "sections": [
        "page-head",
        "lede",
        "cards",
        "list",
        "related",
        "cta"
      ]
    },
    {
      "id": "list",
      "use": "A filterable list of records",
      "sections": [
        "page-head",
        "filter",
        "list",
        "cta"
      ]
    },
    {
      "id": "longread",
      "use": "A paper summary, data story, methods page or post",
      "sections": [
        "page-head",
        "toc",
        "prose",
        "figure",
        "chart",
        "related",
        "cta"
      ]
    },
    {
      "id": "product",
      "use": "A product's page that hands off to its own site",
      "sections": [
        "page-head",
        "lede",
        "figure",
        "ledger",
        "cta"
      ]
    },
    {
      "id": "sdk",
      "use": "An SDK or MCP page",
      "sections": [
        "page-head",
        "modules",
        "code",
        "ledger",
        "cta"
      ]
    },
    {
      "id": "work",
      "use": "Capabilities, solutions and industries, thirteen pages",
      "sections": [
        "page-head",
        "plates",
        "prose",
        "figure",
        "related",
        "cta"
      ]
    },
    {
      "id": "people",
      "use": "Team and campus partners",
      "sections": [
        "page-head",
        "people",
        "related",
        "cta"
      ]
    },
    {
      "id": "policy",
      "use": "Trust pages and commitments: the plain summary first",
      "sections": [
        "page-head",
        "ledger",
        "toc",
        "prose",
        "related"
      ]
    },
    {
      "id": "brand",
      "use": "The public brand page",
      "sections": [
        "page-head",
        "plates",
        "cards",
        "list",
        "cta"
      ]
    },
    {
      "id": "contact",
      "use": "The contact page for people who arrive by link",
      "sections": [
        "page-head",
        "form"
      ]
    },
    {
      "id": "doors",
      "use": "Pulp101: two doors behind a sign-in",
      "sections": [
        "page-head",
        "doors",
        "form"
      ]
    },
    {
      "id": "not-found",
      "use": "404",
      "sections": [
        "not-found"
      ]
