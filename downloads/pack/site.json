  "childRoutes": {
    "/research/stories/<slug>": "longread",
    "/lab/pulp101/letters/<slug>": "longread",
    "/lab/pulp101/numbers/<slug>": "longread"
  },
  "slots": [
    {
      "id": "copy-pages",
      "kind": "copy",
      "pages": "every page but /",
      "spec": "Final copy in Shah's voice for each page's sections, from the outline in SITEMAP. Matter-of-fact, American spelling, no dashes, no banned phrases."
    },
    {
      "id": "photo-hero",
      "kind": "photo",
      "pages": "/",
      "spec": "Filled: stairs, by Jos\u00e9 Mart\u00edn Ram\u00edrez Carrasco (Unsplash License), behind the hero."
    },
    {
      "id": "photo-break",
      "kind": "photo",
      "pages": "/",
      "spec": "Filled: crowd, by Amir Arabshahi (Unsplash License), the break before the scale of conversation."
    },
    {
      "id": "photo-plan",
      "kind": "photo",
      "pages": "every page in PHOTO_PLAN without a photo yet",
      "spec": "One photograph per page from the approved library, never one already used (R-PHO-08). Shah approves each before it is downloaded; PHOTO_PLAN records where it goes."
    },
    {
      "id": "photos-in-person",
      "kind": "photo",
      "pages": "/research/talks, /foundation/apprenticeship, /company/careers",
      "spec": "Real photographs of Pulp events and people, with a signed consent for every face."
    },
    {
      "id": "team",
      "kind": "data",
      "pages": "/company/team",
      "spec": "Per person: name, role, photo with consent, their color from the palette, a three-line bio."
    },
    {
      "id": "papers",
      "kind": "data",
      "pages": "/research/papers, /research",
      "spec": "Per paper: title, authors, venue, year, topic (reasoning, persuasion, attention, metacognition), exact status (accepted, presented, under review, published), abstract, PDF file, citation."
    },
    {
      "id": "posts",
      "kind": "data",
      "pages": "/lab/pulp101",
      "spec": "Per post, behind the sign-in: title, author, date, blog (Letters or Numbers), the text, and its sources."
    },
    {
      "id": "glossary",
      "kind": "copy",
      "pages": "/research/methods",
      "spec": "Each term and its plain definition; the list opens each term in the details modal."
    },
    {
      "id": "talks",
      "kind": "data",
      "pages": "/research/talks",
      "spec": "Per talk: place, date, title, who spoke, link."
    },
    {
      "id": "stories",
      "kind": "data",
      "pages": "/research/stories",
      "spec": "Per story: title, reading time, sources, data files; From Stone to Screen is the first."
    },
    {
      "id": "press",
      "kind": "data",
      "pages": "/company/press, /company/brand",
      "spec": "Announcements with dates, a press kit zip, and a media contact address."
    },
    {
      "id": "roles",
      "kind": "data",
      "pages": "/company/careers",
      "spec": "Open roles: title, team, place, what the work is, how to apply."
    },
    {
      "id": "policies",
      "kind": "copy",
      "pages": "/trust/*",
      "spec": "Privacy, consent, security, accessibility audit status and terms, approved for publishing."
    },
    {
      "id": "sustainability-data",
      "kind": "data",
      "pages": "/trust/sustainability",
      "spec": "Measured compute and energy with units, sources and dates."
    },
    {
      "id": "product-media",
      "kind": "photo",
      "pages": "/lab/thinkwell",
      "spec": "Screens or a short clip of Thinkwell running, in light and dark."
    },
    {
      "id": "endpoints",
      "kind": "endpoint",
      "pages": "/company/contact, /platform/api, /lab/suade, /lab/pulp101",
      "spec": "Where the forms send (the contact modal on every page, request access, join the list, the Pulp101 sign-in): one HTTPS endpoint that accepts a plain form POST and answers with a redirect to a thank-you state; the script sends the same fields and reads a 2xx."
    },
    {
      "id": "docs-links",
      "kind": "data",
      "pages": "/platform/*, /lab/loosethreads",
      "spec": "The live URLs for pulp.com.ai/docs: API, Loosethreads and MCP."
    },
    {
      "id": "suade",
      "kind": "copy",
      "pages": "/lab/suade",
      "spec": "What Suade is, in two lines."
    }
  ],
