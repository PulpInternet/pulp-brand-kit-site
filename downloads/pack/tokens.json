      },
      {
        "text": "No italics in any display type.",
        "rule": "R-TYPE-02"
      },
      {
        "text": "Light, dark and mono, and the switch test.",
        "rule": "R-MODE-02"
      },
      {
        "text": "44 px targets and every kind of input.",
        "rule": "R-LAY-04"
      },
      {
        "text": "Secondary views float as modals.",
        "rule": "R-CMP-05"
      },
      {
        "text": "Focus by brightness.",
        "rule": "R-CMP-07"
      },
      {
        "text": "Gradients only from tokens. No edge stripes.",
        "rule": "R-COL-08"
      },
      {
        "text": "Every number has a unit and a source.",
        "rule": "R-DATA-01"
      },
      {
        "text": "Pulp is always the full wordmark.",
        "rule": "R-LOGO-01"
      },
      {
        "text": "Real people are never dithered.",
        "rule": "R-IMG-02"
      }
